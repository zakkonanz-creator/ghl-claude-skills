{
  "comment": "Global fields available on every account, read from the platform's own merge field catalogue. contactFields are the built-in contact fields; systemFields pull from calendars, appointments, users, invoices and the like. Per account custom fields and custom values live in <locationId>.json, not here.",
  "source": "GET /custom-data/{conversations|emails}?locationId=<loc>&types=custom-values",
  "syncedAt": "2026-08-27",
  "disproven": {
    "{{contact.full_name}}": {
      "correctField": "{{contact.name}}",
      "label": "Full Name",
      "note": "Does not exist. Saves without error and resolves to nothing, so the message ships malformed.",
      "evidence": "9 reviewer notes across B, D and E, 2026-08-27. The catalogue lists Full Name as {{contact.name}}."
    },
    "{{opportunity.monetary_value}}": {
      "correctField": "{{opportunity.lead_value}}",
      "evidence": "Resolves empty. 2026-08-18 reconciliation."
    },
    "{{opportunity.value}}": {
      "correctField": "{{opportunity.lead_value}}",
      "evidence": "Resolves empty. 2026-08-18 reconciliation."
    },
    "{{opportunity.opportunity_value}}": {
      "correctField": "{{opportunity.lead_value}}",
      "evidence": "Resolves empty. 2026-08-18 reconciliation."
    },
    "{{right_now.date}}": {
      "correctField": "{{right_now.middle_endian_date}}",
      "note": "There is no bare .date variant. The catalogue offers middle_endian_date (month/day/year) and little_endian_date (day/month/year). Pick by locale.",
      "evidence": "Found by the field gate 2026-08-27 in A2, C and D. Consistent with reviewer notes on C and D reporting empty date pickers that had to be set to Current Date by hand."
    },
    "{{right_now}}": {
      "correctField": "{{right_now.middle_endian_date}}",
      "note": "Bare right_now is a group label in the picker, not a field. It resolves to nothing.",
      "evidence": "Found by the field gate 2026-08-27 in D."
    }
  },
  "provenElsewhere": {
    "{{opportunity.lead_value}}": {
      "note": "Not in the static catalogue but proven by live run. Re-resolves after a Find step.",
      "evidence": "Workflow E accumulator, 2026-08-18 reconciliation."
    }
  },
